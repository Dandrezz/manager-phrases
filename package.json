{
  "name": "frases-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create frases-db",
    "db:migrate": "wrangler d1 execute frases-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute frases-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.80.0"
  }
}
